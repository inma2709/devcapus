{
  "name": "devcampusept",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:verify": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:DEVCAMPUS_SHELL_BUILD='1'; & .\\node_modules\\.bin\\vite.cmd build --outDir $env:TEMP\\devcampus-portal-verify --emptyOutDir\"",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "powershell -ExecutionPolicy Bypass -File deploy-all.ps1",
    "deploy:all": "powershell -ExecutionPolicy Bypass -File deploy-all.ps1",
    "deploy:manual-html": "powershell -ExecutionPolicy Bypass -File deploy-manual-html.ps1",
    "deploy:manual-css": "powershell -ExecutionPolicy Bypass -File ./deploy-manual-css.ps1",
    "deploy:manual-javascript": "powershell -ExecutionPolicy Bypass -File ./deploy-manual-javascript.ps1",
    "deploy:manual-node": "powershell -ExecutionPolicy Bypass -File ./deploy-manual-node.ps1",
    "deploy:backend": "powershell -ExecutionPolicy Bypass -File ./deploy-backend-manual.ps1",
    "rollback:backend": "powershell -ExecutionPolicy Bypass -File ./rollback-backend-manual.ps1",
    "deploy:portal": "powershell -ExecutionPolicy Bypass -File deploy-portal.ps1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
